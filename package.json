{
  "name": "jarvis",
  "productName": "JARVIS",
  "version": "0.1.0",
  "private": true,
  "description": "J.A.R.V.I.S. \u2014 local-first, voice-capable desktop assistant",
  "author": "Ryan Foster",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs --soft",
    "setup:electron": "node scripts/ensure-electron.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "predev": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "prepreview": "node scripts/ensure-electron.mjs",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "test:e2e": "npm run typecheck:e2e && electron-vite build && playwright test",
    "sunrise": "node scripts/sunrise.mjs",
    "sunset": "node scripts/sunset.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-orm": "^0.45.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "electron": true
  }
}
