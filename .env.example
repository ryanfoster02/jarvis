# JARVIS development environment.
# Create your own copy with:  npm run setup:env   (or: cp .env.example .env)
# .env is git-ignored — never commit real values.
#
# Read only by the Electron main process in development; ignored in packaged builds.
# While set, these override keys saved in Settings → AI provider.
# Do NOT rename them with a VITE_ prefix: that would bundle the keys into the interface.

# OpenAI — listening and thinking (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic — optional: Claude models for typed replies (https://platform.claude.com → Settings → API keys).
# Voice still uses OpenAI. Pick a Claude model in Settings → Voice → Typed replies model.
ANTHROPIC_API_KEY=

# ElevenLabs — Jarvis's British voice (https://elevenlabs.io → Developers → API keys;
# the key needs the Text to Speech permission)
ELEVENLABS_API_KEY=
