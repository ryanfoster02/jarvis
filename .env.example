# JARVIS development environment.
# Create your own copy with:  npm run setup:env   (or: cp .env.example .env)
# .env is git-ignored — never commit real values.
#
# OpenAI API key used for voice (https://platform.openai.com/api-keys).
# Read only by the Electron main process in development; ignored in packaged builds.
# It overrides a key saved in Settings → AI provider while it's set.
# Do NOT rename it with a VITE_ prefix: that would bundle it into the interface.
OPENAI_API_KEY=
